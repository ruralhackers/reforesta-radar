# Copiar a /opt/apps/reforesta-radar/.env en el servidor (chmod 600). Nunca al repo.
PORT=8116
TZ=Europe/Madrid

ANTHROPIC_API_KEY=
RESEND_API_KEY=
RADAR_DIGEST_DESTINATARIOS=persona1@ejemplo.org,persona2@ejemplo.org
RADAR_DIGEST_REMITENTE=Radar Reforesta <no-reply@out.ruralhackers.com>
RADAR_URL_PUBLICA=https://reforesta.ruralhackers.com

# Detras del tunel de Cloudflare, con HTTPS: cookie Secure, y CF-Connecting-IP de confianza
# (el puerto solo escucha en 127.0.0.1).
RADAR_COOKIE_SECURE=1

# Vacio = modo demo publica (sin zona de equipo). Con valor, pide contrasena y SESSION_SECRET.
TEAM_PASSWORD=
# SESSION_SECRET=   (openssl rand -hex 32; solo si TEAM_PASSWORD tiene valor)

# Topes de coste/tiempo (opcionales; valores por defecto en src/config.ts). Vacío = valor por defecto;
# un valor no numérico o negativo hace que el radar no arranque (mensaje claro, código 1).
# Presupuesto de LLM por ejecución, común a todas las fases (criba, análisis, fundaciones, DIA, huella). La demo es pública y editable:
# este es el techo real de gasto por día (el radar corre una vez al día).
RADAR_PRESUPUESTO_USD=1.00
RADAR_MAX_ANALISIS=20
# RADAR_MAX_HUELLA=
# RADAR_MAX_FUNDACIONES=
# RADAR_MAX_PETICIONES_GANADORES=
# RADAR_MAX_PETICIONES_PARECIDAS=
# RADAR_MAX_PETICIONES_FT=
# RADAR_MODELO_ANALISIS=
# RADAR_MODELO_CRIBA=
