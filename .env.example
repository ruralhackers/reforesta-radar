# Puerto publicado en el host (compose lo enlaza a 127.0.0.1)
PORT=8116
# Días hacia atrás que revisa cada pasada del radar
LOOKBACK_DAYS=7
# Semilla que se carga si la BD no tiene perfil
# SEED_FILE=seed/perfil.json
# Claude (Anthropic). Sin clave, el radar se salta la criba LLM y el análisis y lo apunta en el registro.
# ANTHROPIC_API_KEY=
# RADAR_MODELO_CRIBA=claude-haiku-5-5
# RADAR_MODELO_ANALISIS=claude-sonnet-5-5
# Los valores numéricos se validan al arrancar: vacío = valor por defecto; no numérico o negativo = error y código 1.
# Máximo de análisis (llamadas a Sonnet) por ejecución; lo que pase se analiza en la siguiente
# RADAR_MAX_ANALISIS=20
# Presupuesto de LLM (USD) por ejecución, común a todas las fases; cuenta también las llamadas que fallan tras cobrarse.
# Al agotarse no se hacen más llamadas y lo que falta queda para la siguiente ejecución
# RADAR_PRESUPUESTO_USD=1.00
# Caracteres de documentos que entran como máximo en UN análisis (lo que sobra se recorta con una nota)
# RADAR_MAX_CARACTERES_ANALISIS=300000
# Intentos fallidos del LLM (respuesta cortada, rechazo, JSON no válido) tras los que una convocatoria deja de reintentarse
# RADAR_MAX_INTENTOS_LLM=3
# Días (por fecha de publicación) en los que se reintentan criba y análisis pendientes
# RADAR_DIAS_PENDIENTES=30
# Fiestas laborales (nacionales y por región) para contar los días hábiles de los plazos
# FESTIVOS_FILE=seed/festivos.json
# Pesos y umbrales de la puntuación (ver README, "Puntuación y ranking")
# PUNTUACION_FILE=seed/puntuacion.json
# Concesiones de BDNS (ganadores previos y organizaciones parecidas): días de caché por consulta y tope de peticiones HTTP por ejecución y pausa entre peticiones (ms)
# RADAR_DIAS_CACHE_GANADORES=7
# RADAR_MAX_PETICIONES_GANADORES=200
# RADAR_PAUSA_BDNS_MS=250
# Descubrimiento por organizaciones parecidas: tope de peticiones a BDNS (dentro del total de arriba), año desde el que se miran las concesiones (2022 = todo lo que hay en BDNS) y días de antigüedad máxima de la edición nueva
# RADAR_MAX_PETICIONES_PARECIDAS=100
# RADAR_DESDE_ANIO_PARECIDAS=2022
# RADAR_DIAS_EDICION_PARECIDAS=400
# Decisiones del equipo como ejemplos en los prompts (últimas N)
# RADAR_EJEMPLOS_DECISIONES=20
# Modo privado. Sin TEAM_PASSWORD todo es público y editable (demo). Con ella:
#  - piden contraseña todas las escrituras (decisiones, notas, perfil, organizaciones parecidas, fundaciones vigiladas, estado y nota de
#    empresas) y las lecturas del trabajo del equipo (/api/equipo/*: decisiones, "nos interesa", notas, empresas con estado y nota);
#  - siguen públicas las lecturas de "Esta semana", fichas, descartes, ejecuciones, "Cómo sabemos", perfil, parecidas, fundaciones y
#    empresas (sin estado ni nota; el filtro ?estado= es solo del equipo).
# Entrar da una cookie firmada de 180 días; cambiar la contraseña la invalida.
# TEAM_PASSWORD=
# Secreto largo y aleatorio que se mezcla en la firma de la cookie (recomendado con TEAM_PASSWORD)
# SESSION_SECRET=
# Fuerza la marca Secure de la cookie (1/0). Por defecto, según https o X-Forwarded-Proto
# RADAR_COOKIE_SECURE=
#   En el VPS (Cloudflare Tunnel, la app ve http local): RADAR_COOKIE_SECURE=1
# IP del cliente para el límite de intentos: CF-Connecting-IP (Cloudflare); sin cabecera, la dirección del socket.
# CF-Connecting-IP se fía solo porque el puerto va en 127.0.0.1 y se llega únicamente por Cloudflare Tunnel; si se expone directo, se puede falsificar
# y el límite se esquiva. Tras 10 fallos desde una IP/NAT, ni la contraseña buena entra durante 15 min.
# Solo detrás de un proxy propio que fije X-Forwarded-For / X-Real-IP: RADAR_CONFIAR_X_FORWARDED_FOR=1
# RADAR_CONFIAR_X_FORWARDED_FOR=
# Correo del lunes (npm run digest). Sin destinatarios no se envía nada (sale con 0). Con destinatarios y sin RESEND_API_KEY, error.
# RESEND_API_KEY=
# RADAR_DIGEST_DESTINATARIOS=ana@ejemplo.org,luis@ejemplo.org
# RADAR_DIGEST_REMITENTE=Radar Reforesta <no-reply@out.ruralhackers.com>
# URL pública de TU instancia, para los enlaces a cada ficha del correo. Sin valor por defecto: sin ella el correo no se envía
# (error claro) y la vista previa usa enlaces relativos
# RADAR_URL_PUBLICA=https://radar.tu-dominio.org
# Fuente EU Funding & Tenders (SEDIA): pausa entre páginas (ms) y tope de peticiones por ejecución (50 resultados por página)
# RADAR_PAUSA_FT_MS=500
# RADAR_MAX_PETICIONES_FT=8
# Fundaciones vigiladas: pausa entre páginas (ms), tiempo máximo (ms) y tamaño máximo (bytes) de cada página, tope de fuentes por ejecución y de caracteres que se pasan al LLM
# RADAR_PAUSA_FUNDACIONES_MS=1000
# RADAR_TIMEOUT_FUNDACIONES_MS=30000
# RADAR_MAX_BYTES_FUNDACIONES=3145728
# RADAR_MAX_FUNDACIONES=60
# RADAR_MAX_CARACTERES_FUNDACIONES=60000
# Empresas desde las DIA del BOE: días hacia atrás (los ya revisados no se repiten), tope de resoluciones leídas con el LLM por ejecución, pausa entre peticiones al BOE (ms) y caracteres máximos de una resolución
# RADAR_DIAS_DIA_BOE=60
# RADAR_MAX_DIA_BOE=40
# Registro de huella de carbono del MITECO: organizaciones que se criban con el LLM por ejecución y años de huella que cuentan como recientes
# RADAR_MAX_HUELLA=50
# Letras CNAE de sectores afines para empresas solo por zona y sector (baja confianza); la zona sale del ámbito del perfil. Por defecto: extractivas, energía, agua y residuos, construcción, comercio, transporte
# RADAR_SECTORES_HUELLA=B,D,E,F,G,H
# RADAR_ANIOS_HUELLA=3
# RADAR_PAUSA_BOE_MS=300
# RADAR_MAX_CARACTERES_DIA_BOE=150000
# Backtest "Cómo sabemos" (npm run backtest): BD de trabajo (criba y caché del LLM), tope de convocatorias del conjunto (b) por ejecución, detalles por pasada al construirlo, e informe público que sirve /api/backtest si la BD aún no tiene resultados
# BACKTEST_DB=data/backtest/trabajo.sqlite
# BACKTEST_MAX_B=150
# BACKTEST_MAX_DETALLES_B=400
# BACKTEST_FILE=seed/backtest.json
