    "record:concesiones": "node scripts/record-bdns-concesiones.ts",
    "record:parecidas": "node scripts/record-bdns-parecidas.ts",
    "record:eu-ft": "node scripts/record-eu-ft.ts",
    "record:eu-cascada": "node scripts/record-eu-cascada.ts",
    "record:fundaciones": "node scripts/record-fundaciones.ts",
    "record:boe": "node scripts/record-boe.ts",
    "record:huella": "node scripts/record-huella.ts",
